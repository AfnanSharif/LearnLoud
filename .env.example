# Optional: the app is fully usable in offline mode without these values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional Coqui and Tortoise speech configuration.
TTS_DEVICE=cpu
TACOTRON_MODEL=tts_models/en/ljspeech/tacotron2-DDC
GLOW_TTS_MODEL=tts_models/en/ljspeech/glow-tts
YOURTTS_MODEL=tts_models/multilingual/multi-dataset/your_tts
# Set only to a speaker name supported by the selected YourTTS checkpoint.
YOURTTS_SPEAKER=
